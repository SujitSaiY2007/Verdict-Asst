# Local-first routing. Cloud is disabled unless explicitly enabled.
VERDICT_CLOUD_FALLBACK=false
VERDICT_CLOUD_ORDER=gemini,groq,openrouter

# Local model endpoints
VERDICT_OLLAMA_URL=http://localhost:11434/v1
VERDICT_OLLAMA_MODEL=llama3.2
VERDICT_LMSTUDIO_URL=http://localhost:1234/v1
VERDICT_LMSTUDIO_MODEL=local-model

# Optional cloud APIs (configure only providers whose free tier you have checked)
GEMINI_API_KEY=
VERDICT_GEMINI_MODEL=
GROQ_API_KEY=
VERDICT_GROQ_MODEL=
OPENROUTER_API_KEY=
VERDICT_OPENROUTER_MODEL=

# Reliability and cache
VERDICT_TIMEOUT=20
VERDICT_COOLDOWN=60
VERDICT_CACHE=true
VERDICT_CACHE_TTL=86400
# VERDICT_DB=/custom/path/verdict.db
